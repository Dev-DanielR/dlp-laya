DEX_ISSUER=https://knowsyn.dev/oauth2
DEX_CLIENT_ID=dlp-laya
DEX_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://localhost:8443/auth/callback
SESSION_SECRET=replace-with-long-random
# COOKIE_SECURE=1
# APP_PUBLIC_URL=https://localhost:8443

# Classify: stub = ManifestDlpStub (A/B); dlp = localhost daemon in same container
CLASSIFY_MODE=stub
# CLASSIFY_MODE=dlp
# DLP_URL=http://127.0.0.1:8091
# DLP_PORT=8091
# DLP_AUTOSTART=1
# DLP_DETECTOR=laya
# DLP_DEBOUNCE_SECONDS=2
# DLP_LOCK_SECONDS=120
# DLP_WAIT_SECONDS=120
# DLP_WARMUP_DELAY_SECONDS=0
# GPU: build WITH_GPU=1, start with ENABLE_GPU=1 (default). Needs Docker NVIDIA runtime.
# LAYA_DEVICE=cuda
# LAYA_THRESHOLD=0.5
# LAYA_REGION=US
# Weights are baked into the image at /opt/laya-cache (override only if needed).
# LAYA_CACHE_DIR=/opt/laya-cache
# HF_HUB_OFFLINE=1

# Lab NetBird users (not read by Flask; used by Playwright UC04 / humans):
